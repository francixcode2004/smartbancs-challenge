# Copiar a .env. scripts/start.ps1 genera JWT_SECRET al crear el archivo.
# No subir .env al repositorio.
JWT_SECRET=

# Necesaria para analizar movimientos con OpenAI; la banca funciona sin esta clave.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Alias compatible con instalaciones anteriores; preferir OPENAI_API_KEY.
API_KEY=

# Credenciales de Grafana solo para la demo local.
GRAFANA_ADMIN_PASSWORD=smartbancs_local
