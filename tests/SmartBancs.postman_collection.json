        {
          "name": "01 Registrar Pepito y crear cuenta en cero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pepito Demo\",\n  \"email\": \"{{pepitoEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const run = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"pepitoEmail\", \"pepito.\" + run + \"@smartbancs.example\");",
                  "pm.collectionVariables.set(\"mariaEmail\", \"maria.\" + run + \"@smartbancs.example\");",
                  "pm.collectionVariables.set(\"temporaryEmail\", \"temporary.\" + run + \"@smartbancs.example\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"pepitoAccount\", pm.response.json().accountNumber);",
                  "pm.test(\"Cuenta de ocho digitos\", () => pm.expect(pm.response.json().accountNumber).to.match(/^[0-9]{8}$/));"
                ]
              }
            }
          ]
        },
